# /etc/triage/triage.env  (chmod 600, owned by root, readable by the triage user)
# systemd reads this file: comments must be on their own line (no "VALUE  # comment").

TRIAGE_DATABASE_URL=postgresql://triage:CHANGE_ME@localhost:5432/triage
# openssl rand -hex 32
TRIAGE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Optional. Empty = briefs come from the deterministic template writer.
OPENAI_API_KEY=
# false (demo): every run scores the synthetic data's end date, so results stay stable however
#   long the server runs (the generated data has no new arrivals after that date).
# true (real data): score "today" (server date).
TRIAGE_USE_WALL_CLOCK=false
# Optional Slack-compatible incoming webhook. Empty = alerts go to the log (journalctl) only.
TRIAGE_ALERT_WEBHOOK_URL=
# Seconds to wait before the single automatic retry of a failed run.
TRIAGE_RETRY_BACKOFF_S=60
TRIAGE_LOG_FORMAT=json
TRIAGE_ENV=production
OTEL_SERVICE_NAME=triage
# Optional: export traces/metrics to an OTLP collector. Unset = no export;
# logs still carry trace_id / request_id / user_name.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
