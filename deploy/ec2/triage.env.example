# /etc/triage/triage.env  (chmod 600, owned by the triage user)
TRIAGE_DATABASE_URL=postgresql://triage:CHANGE_ME@localhost:5432/triage
TRIAGE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
OPENAI_API_KEY=
TRIAGE_USE_WALL_CLOCK=true            # score "today", not the demo date
TRIAGE_ALERT_WEBHOOK_URL=             # Slack-compatible incoming webhook
TRIAGE_RETRY_BACKOFF_S=60             # wait before the single automatic retry
TRIAGE_LOG_FORMAT=json
TRIAGE_ENV=production
# Optional: leave unset to skip exporting. Logs still carry trace_id/request_id/user_name.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # only if you run an OTLP collector
OTEL_SERVICE_NAME=triage
