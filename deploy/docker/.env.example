# Copy to deploy/docker/.env (gitignored) and fill in. Read by docker compose and the app containers.
# Comments must be on their own line.

# --- required
# openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -hex 32
TRIAGE_JWT_SECRET=CHANGE_ME
# Public host name for HTTPS, e.g. 13-233-10-20.sslip.io (see EC2_SETUP.md step 10). ":80" = plain HTTP (local test)
SITE_HOST=CHANGE_ME
# Password for the seeded demo logins (used by `bootstrap`)
TRIAGE_DEMO_PASSWORD=CHANGE_ME

# --- optional
# Empty = briefs come from the deterministic template writer
OPENAI_API_KEY=
# Slack-compatible incoming webhook. Empty = alerts only in the logs
TRIAGE_ALERT_WEBHOOK_URL=

# --- behaviour
# false (demo): runs score the synthetic data's end date, so results stay stable. true: score "today".
TRIAGE_USE_WALL_CLOCK=false
# Nightly run time in each tenant's own timezone, and the watchdog time in UTC
TRIAGE_SCHEDULE_RUN_AT=02:00
TRIAGE_SCHEDULE_WATCHDOG_AT=06:30
TRIAGE_RETRY_BACKOFF_S=60
TRIAGE_ENV=production
OTEL_SERVICE_NAME=triage
